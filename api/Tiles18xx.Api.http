# Sample requests for the API. In Visual Studio, click "Send request" above each one.
# Add a request here for each new endpoint.
@Tiles18xx.Api_HostAddress = http://localhost:5010

### Health check
GET {{Tiles18xx.Api_HostAddress}}/api/health
Accept: application/json

### All games (Step 2.1)
GET {{Tiles18xx.Api_HostAddress}}/api/games
Accept: application/json

### One game (Step 2.1); change the id as needed
GET {{Tiles18xx.Api_HostAddress}}/api/games/1
Accept: application/json


### Tiles: 1830, page 1 (Step 2.2)
GET {{Tiles18xx.Api_HostAddress}}/api/tiles?game=25
Accept: application/json

### Tiles: yellow towns
GET {{Tiles18xx.Api_HostAddress}}/api/tiles?color=yellow&kind=town
Accept: application/json

### Tiles: bad input (expect 400 with three errors)
GET {{Tiles18xx.Api_HostAddress}}/api/tiles?color=pink&kind=village&page=0
Accept: application/json


###
