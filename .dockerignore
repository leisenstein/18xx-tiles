# Files Docker should NOT copy into the build.

# Downloaded packages and build output (Docker rebuilds these itself)
**/node_modules
**/bin
**/obj
**/dist

# Git and Visual Studio folders
.git
.vs

# Local database files
data/
*.db
*.db-wal
*.db-shm

# Folders the app does not need
reference/
tools/

# Do NOT add api/Data/Seeding/SeedFiles here. The seed files must be included in the build.