# Website settings. Copy to .env (or .env.local) in this folder and fill in only what you need; every value has a default. Not committed: .env is
# ignored by git. See vite.config.ts and src/api/client.ts. Restart "npm run dev" after a change.

# Dev server ("npm run dev") and preview ("npm run preview") ports. Defaults: 5173 and 4173.
VITE_PORT=
VITE_PREVIEW_PORT=

# Extra host names the dev server answers to, comma-separated (for example a tunnel address), or "all". Default: localhost only.
VITE_ALLOWED_HOSTS=

# Where "npm run dev" forwards /api calls. Default: https://localhost:7299 (the API in development).
VITE_API_PROXY_TARGET=
# true = require a trusted certificate from that address. Default false, which accepts the .NET development certificate.
VITE_API_PROXY_SECURE=

# The API's address as the browser should call it, built into the website by "npm run build". Leave empty (the default) when the API serves the
# website itself, as in Docker and on Railway: calls then use relative addresses such as /api/games. Set it only when the API runs on another
# address, for example https://api.example.com; the API must then list the website's address in Cors:AllowedOrigins, and both should share one
# domain (for example example.com and api.example.com), because the sign-in cookie is limited to the same site.
VITE_API_BASE_URL=
