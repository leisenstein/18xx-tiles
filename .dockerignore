# Files Docker should NOT copy into the build.

# Downloaded packages and build output (Docker rebuilds these itself)
**/node_modules
**/bin
**/obj
**/dist

# Git and Visual Studio folders
.git
.vs

# Local database files
data/
*.db
*.db-wal
*.db-shm

# Folders the app does not need. From tools/, only the seed data script and its pinned commit (Dockerfile stage 2).
reference/
tools/**
!tools/import/update_data.py
!tools/import/18xx-commit.txt

# Local seed files: the Docker build always generates its own from the pinned commit (Dockerfile stage 2).
api/Data/Seeding/SeedFiles/*.json

# Local secrets for docker compose (see .env.example)
.env
