# Copy this file to .env (not committed) and fill in the values. docker compose reads .env automatically.
# Use single quotes around a password that contains $, so compose does not treat it as a variable.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Nightly backups: how many snapshots to keep (default 90) and when to take them, 24-hour UTC time (default 03:00).
BACKUP_RETAIN_COUNT=
BACKUP_RUN_AT=
# The site's public address, used in password-reset email links. Defaults to http://localhost:8080.
PUBLIC_URL=
# Optional: send real emails through Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend, e.g. 18xx Tiles <no-reply@example.com>
RESEND_API_KEY=
EMAIL_FROM=
